<Layouts.flash_group flash={@flash} />

<%!-- ═══ Fixed Navigation Header ═══════════════════════════════════════════════ --%>
<header class="fixed top-0 w-full z-50 bg-surface/95 backdrop-blur-md shadow-sm">
  <nav class="flex justify-between items-center max-w-container-max mx-auto px-md h-16">
    <%!-- Brand --%>
    <div class="flex-shrink-0 flex items-center gap-2">
      <span
        class="material-symbols-outlined text-primary text-3xl"
        style='font-variation-settings: "FILL" 1'
      >
        terminal
      </span>
      <a
        class="font-h3 text-[24px] leading-[1.4] font-black text-primary tracking-tight"
        href={~p"/"}
      >
        DevWrite
      </a>
    </div>

    <%!-- Desktop navigation links --%>
    <div class="hidden md:flex items-center gap-lg">
      <a
        class="font-ui-label text-ui-label font-semibold text-on-surface-variant hover:text-primary hover:bg-primary-container/10 rounded-lg px-sm py-xs transition-colors duration-200"
        href="#"
      >
        Explore
      </a>
      <a
        class="font-ui-label text-ui-label font-semibold text-on-surface-variant hover:text-primary hover:bg-primary-container/10 rounded-lg px-sm py-xs transition-colors duration-200"
        href="/feed"
      >
        Feed
      </a>
      <a
        class="font-ui-label text-ui-label font-semibold text-on-surface-variant hover:text-primary hover:bg-primary-container/10 rounded-lg px-sm py-xs transition-colors duration-200"
        href="#"
      >
        Communities
      </a>
    </div>

    <%!-- Desktop actions: search + auth buttons + mobile toggle --%>
    <div class="flex items-center gap-md">
      <div class="hidden md:flex items-center bg-surface-variant/50 rounded-full px-sm py-xs border border-outline-variant focus-within:border-primary focus-within:ring-2 focus-within:ring-primary/20 transition-all">
        <span class="material-symbols-outlined text-outline text-sm mr-2">search</span>
        <input
          class="bg-transparent border-none focus:ring-0 text-ui-body p-0 w-48 text-on-surface placeholder:text-outline"
          placeholder="Search..."
          type="text"
        />
      </div>

      <a
        class="font-ui-label text-ui-label font-bold text-primary hover:bg-primary-container/10 px-sm py-xs rounded-lg transition-all duration-200"
        href={~p"/users/log-in"}
      >
        Log In
      </a>

      <a
        class="font-ui-label text-ui-label font-bold bg-[#F05032] text-white px-sm py-xs rounded-lg shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-150"
        href={~p"/users/register"}
      >
        Sign Up
      </a>

      <%!-- Mobile menu toggle --%>
      <button
        class="md:hidden text-on-surface-variant hover:text-primary p-xs rounded-lg hover:bg-primary-container/10 transition-colors"
        phx-click="toggle_menu"
        aria-label="Toggle navigation menu"
      >
        <span class="material-symbols-outlined">
          {if @menu_open, do: "close", else: "menu"}
        </span>
      </button>
    </div>
  </nav>

  <%!-- Mobile dropdown — shown when @menu_open is true --%>
  <div
    :if={@menu_open}
    class="md:hidden bg-surface border-t border-outline-variant px-md py-sm flex flex-col gap-xs"
  >
    <a
      class="font-ui-label text-ui-label font-semibold text-on-surface-variant hover:text-primary py-xs"
      href="#"
    >
      Explore
    </a>
    <a
      class="font-ui-label text-ui-label font-semibold text-on-surface-variant hover:text-primary py-xs"
      href="/feed"
    >
      Feed
    </a>
    <a
      class="font-ui-label text-ui-label font-semibold text-on-surface-variant hover:text-primary py-xs"
      href="#"
    >
      Communities
    </a>
    <div class="flex items-center gap-md pt-xs border-t border-outline-variant mt-xs">
      <a class="font-ui-label text-ui-label font-bold text-primary" href={~p"/users/log-in"}>
        Log In
      </a>
      <a
        class="font-ui-label text-ui-label font-bold bg-[#F05032] text-white px-sm py-xs rounded-lg"
        href={~p"/users/register"}
      >
        Sign Up
      </a>
    </div>
  </div>
</header>

<%!-- ═══ Main Content ═══════════════════════════════════════════════════════════ --%>
<main class="flex-grow pt-24 pb-xl">
  <%!-- ─── Hero Section ─────────────────────────────────────────────────────── --%>
  <section class="max-w-container-max mx-auto px-md py-xl md:py-20 text-center flex flex-col items-center">
    <%!-- Badge --%>
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface-container-high border border-outline-variant mb-8">
      <span
        class="material-symbols-outlined text-primary text-sm"
        style='font-variation-settings: "FILL" 1'
      >
        bolt
      </span>
      <span class="font-ui-label text-ui-label font-semibold text-on-surface-variant">
        v2.0 is now live
      </span>
    </div>

    <%!-- Headline --%>
    <h1 class="font-h1 text-h1 font-extrabold text-on-surface max-w-4xl mx-auto mb-6">
      The Technical Blog for <br class="hidden md:block" />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-[#F05032]">
        Modern Builders
      </span>.
    </h1>

    <%!-- Subheading --%>
    <p class="font-prose-body text-prose-body text-on-surface-variant max-w-2xl mx-auto mb-10">
      A high-fidelity storytelling platform engineered for developers. Share
      code, document architectures, and join a community of technical
      writers who value clarity and precision.
    </p>

    <%!-- CTAs --%>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <%!-- "Start Reading" → /users/register -->
      <a
        class="w-full sm:w-auto font-ui-label text-ui-label font-bold bg-[#F05032] text-white px-8 py-4 rounded-lg shadow-md hover:shadow-lg hover:-translate-y-1 active:scale-95 transition-all duration-200 flex items-center justify-center gap-2"
        href={~p"/users/register"}
      >
        Start Reading
        <span class="material-symbols-outlined text-sm">arrow_forward</span>
      </a>

      <%!-- "View Examples" → scrolls to #preview below --%>
      <a
        class="w-full sm:w-auto font-ui-label text-ui-label font-bold bg-surface-container text-on-surface px-8 py-4 rounded-lg border border-outline-variant hover:border-primary hover:text-primary transition-colors duration-200 flex items-center justify-center gap-2"
        href="#preview"
      >
        <span class="material-symbols-outlined text-sm">code</span> View Examples
      </a>
    </div>
  </section>

  <%!-- ─── Bento Grid Features ───────────────────────────────────────────────── --%>
  <section class="max-w-container-max mx-auto px-md py-xl">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <%!-- Lightning Fast --%>
      <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-lg shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 flex flex-col items-start group">
        <div class="w-12 h-12 rounded-lg bg-surface-container flex items-center justify-center mb-6 group-hover:bg-primary-container/20 transition-colors">
          <span
            class="material-symbols-outlined text-primary text-2xl"
            style='font-variation-settings: "FILL" 1'
          >
            speed
          </span>
        </div>
        <h3 class="font-h3 text-h3 font-semibold text-on-surface mb-3">Lightning Fast</h3>
        <p class="font-ui-body text-ui-body text-on-surface-variant">
          Optimized for instantaneous load times. Our static rendering engine ensures
          your technical content reaches readers without delay, regardless of connection quality.
        </p>
      </div>

      <%!-- Vibrant Community --%>
      <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-lg shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 flex flex-col items-start group">
        <div class="w-12 h-12 rounded-lg bg-surface-container flex items-center justify-center mb-6 group-hover:bg-primary-container/20 transition-colors">
          <span
            class="material-symbols-outlined text-primary text-2xl"
            style='font-variation-settings: "FILL" 1'
          >
            group_work
          </span>
        </div>
        <h3 class="font-h3 text-h3 font-semibold text-on-surface mb-3">Vibrant Community</h3>
        <p class="font-ui-body text-ui-body text-on-surface-variant">
          Connect with engineers worldwide. Engage in high-signal discussions,
          peer-review code snippets, and build your professional network within
          a focused ecosystem.
        </p>
      </div>

      <%!-- Radical Simplicity --%>
      <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-lg shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 flex flex-col items-start group">
        <div class="w-12 h-12 rounded-lg bg-surface-container flex items-center justify-center mb-6 group-hover:bg-primary-container/20 transition-colors">
          <span
            class="material-symbols-outlined text-primary text-2xl"
            style='font-variation-settings: "FILL" 1'
          >
            auto_awesome
          </span>
        </div>
        <h3 class="font-h3 text-h3 font-semibold text-on-surface mb-3">Radical Simplicity</h3>
        <p class="font-ui-body text-ui-body text-on-surface-variant">
          A distraction-free writing experience. Our minimalist editor gets out of your
          way, letting you focus purely on articulating complex technical concepts clearly.
        </p>
      </div>
    </div>
  </section>

  <%!-- ─── Preview Section (scroll target for "View Examples") ─────────────── --%>
  <section
    id="preview"
    class="max-w-container-max mx-auto px-md py-xl border-t border-outline-variant mt-lg"
  >
    <%!-- Section header --%>
    <div class="flex flex-col md:flex-row justify-between items-end mb-8">
      <div>
        <h2 class="font-h2 text-h2 font-bold text-on-surface mb-2">
          Featured Technical deep-dives
        </h2>
        <p class="font-ui-body text-ui-body text-on-surface-variant">
          Hand-picked articles from our community of builders.
        </p>
      </div>
      <a
        class="hidden md:flex font-ui-label text-ui-label font-semibold text-primary hover:underline items-center gap-1"
        href="#"
      >
        View all posts <span class="material-symbols-outlined text-sm">arrow_forward</span>
      </a>
    </div>

    <%!-- Article cards --%>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <%!-- Card 1 — Architecture --%>
      <article class="bg-surface-container-lowest border border-outline-variant rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 flex flex-col">
        <img
          alt="Code on screen"
          class="w-full h-48 object-cover border-b border-outline-variant"
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuBu-YkA0LhE2mgluRXeRLFXU6XvYStf_JwJxD2Q-vQodoyFvHjH80kUZjSSe5TY4BP_eISiQHNn70EM4LXAH8eUU2cV070xlOTGz2YzzJZpRp9DIklkrbQytY4c9K91fcLbFcMnFXDswSAnOp3ubge5YLV8H89CHTssZ4atPmOIexdBg_Mdw6yORDP3YUJ4qc2zAEdXq0teCcZDTTneD-xB2x3i9eOM_vacOJQ5pW9jT1G40MaapK9XC2RpzTU0U2Qtut_FssXJUgA"
        />
        <div class="p-6 flex flex-col flex-grow">
          <div class="flex gap-2 mb-3">
            <span class="font-ui-label text-[12px] font-semibold bg-surface-container text-primary px-2 py-1 rounded">
              ARCHITECTURE
            </span>
            <span class="font-ui-label text-[12px] font-semibold bg-surface-container text-on-surface-variant px-2 py-1 rounded">
              5 MIN READ
            </span>
          </div>
          <h3 class="font-h3 text-h3 font-semibold text-on-surface mb-2 hover:text-primary transition-colors cursor-pointer">
            Building Resilient Microservices
          </h3>
          <p class="font-ui-body text-ui-body text-on-surface-variant mb-4 flex-grow">
            An exploration of circuit breakers, retry mechanisms, and graceful
            degradation strategies in modern distributed systems.
          </p>
          <div class="flex items-center gap-3 mt-auto pt-4 border-t border-outline-variant">
            <div class="w-8 h-8 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center font-bold text-sm">
              JS
            </div>
            <div>
              <p class="font-ui-label text-ui-label font-semibold text-on-surface">Jane Smith</p>
              <p class="font-ui-body text-[12px] text-on-surface-variant">
                Senior Staff Engineer
              </p>
            </div>
          </div>
        </div>
      </article>

      <%!-- Card 2 — Performance --%>
      <article class="bg-surface-container-lowest border border-outline-variant rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 flex flex-col">
        <img
          alt="Laptop on desk"
          class="w-full h-48 object-cover border-b border-outline-variant"
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuAGm5C4CJis0M_u_WapG5ZNypZfA9EJMP6uOISxbxi_KVVUvYkQFewPIgNjm3gthfanjAWCkI453xHeyAb92fUn4jJER080kCP9SFt5P5JwYeUbYh0vn4s1mqx_eb15sWnnL99uJnnfqYSdbryi9CMS6ePgkc7CzgvSJ9O3-8nGOy2yh336pAsAwyi109Kv-lGF6QoYY6zJ7162dMgXLZwfHPQ5HGsdmafopAkzSkaLQYGtYQ5Mxr0FakWFTPHYe_gJSdWbPonU7TI"
        />
        <div class="p-6 flex flex-col flex-grow">
          <div class="flex gap-2 mb-3">
            <span class="font-ui-label text-[12px] font-semibold bg-surface-container text-primary px-2 py-1 rounded">
              PERFORMANCE
            </span>
            <span class="font-ui-label text-[12px] font-semibold bg-surface-container text-on-surface-variant px-2 py-1 rounded">
              8 MIN READ
            </span>
          </div>
          <h3 class="font-h3 text-h3 font-semibold text-on-surface mb-2 hover:text-primary transition-colors cursor-pointer">
            Optimizing React Context
          </h3>
          <p class="font-ui-body text-ui-body text-on-surface-variant mb-4 flex-grow">
            Techniques to prevent unnecessary re-renders when passing complex
            state objects down the component tree.
          </p>
          <div class="flex items-center gap-3 mt-auto pt-4 border-t border-outline-variant">
            <div class="w-8 h-8 rounded-full bg-tertiary-container text-on-tertiary-container flex items-center justify-center font-bold text-sm">
              AD
            </div>
            <div>
              <p class="font-ui-label text-ui-label font-semibold text-on-surface">Alex Doe</p>
              <p class="font-ui-body text-[12px] text-on-surface-variant">Frontend Architect</p>
            </div>
          </div>
        </div>
      </article>
    </div>

    <%!-- Mobile "View all" link --%>
    <a
      class="md:hidden mt-6 flex justify-center font-ui-label text-ui-label font-semibold text-primary border border-primary/30 rounded-lg py-3 hover:bg-primary-container/10 transition-colors"
      href="#"
    >
      View all posts
    </a>
  </section>
</main>

<%!-- ═══ Footer ════════════════════════════════════════════════════════════════ --%>
<footer class="w-full bg-surface-container-lowest border-t border-outline-variant">
  <div class="max-w-container-max mx-auto px-md py-lg flex flex-col md:flex-row justify-between items-center gap-sm">
    <span class="font-ui-label text-ui-label font-bold text-primary">
      &copy; {Date.utc_today().year} DevWrite. Crafted for the modern engineer.
    </span>
    <div class="flex flex-wrap justify-center gap-md">
      <a
        class="font-ui-label text-ui-label font-semibold text-on-surface-variant hover:text-primary transition-colors opacity-80 hover:opacity-100"
        href="#"
      >
        Changelog
      </a>
      <a
        class="font-ui-label text-ui-label font-semibold text-on-surface-variant hover:text-primary transition-colors opacity-80 hover:opacity-100"
        href="#"
      >
        API Docs
      </a>
      <a
        class="font-ui-label text-ui-label font-semibold text-on-surface-variant hover:text-primary transition-colors opacity-80 hover:opacity-100"
        href="#"
      >
        Privacy Policy
      </a>
      <a
        class="font-ui-label text-ui-label font-semibold text-on-surface-variant hover:text-primary transition-colors opacity-80 hover:opacity-100"
        href="#"
      >
        Code of Conduct
      </a>
    </div>
  </div>
</footer>
